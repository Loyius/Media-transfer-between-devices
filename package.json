{
  "name": "media-transfer-app",
  "version": "2.0.0",
  "description": "Cross-platform media transfer app with WebRTC and WebSocket fallback",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "server:dev": "cross-env PORT=3001 node server.js",
    "client:dev": "vite --config client/vite.config.mjs",
    "client:build": "vite build --config client/vite.config.mjs",
    "build": "npm run client:build",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "preview": "vite preview --config client/vite.config.mjs"
  },
  "dependencies": {
    "express": "^4.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-peer": "^9.11.1",
    "socket.io": "^4.6.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "vite": "^5.4.11"
  }
}